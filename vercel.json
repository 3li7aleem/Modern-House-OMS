{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/invoice/:id*",
      "destination": "/api/invoice/:id*"
    },
    {
      "source": "/download/:file*",
      "destination": "/api/download/:file*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|download/|invoice/).*)",
      "destination": "/index.html"
    }
  ]
}
