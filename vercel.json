{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "desktop",
          "format": "url",
          "env": "DESKTOP_API_URL"
        }
      ]
    },
    "desktop": {
      "root": "src/desktop",
      "runtime": "node",
      "entrypoint": "server.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "desktop"
      }
    },
    {
      "source": "/invoice/(.*)",
      "destination": {
        "service": "desktop"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
