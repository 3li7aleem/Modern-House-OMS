{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory products",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "category": { "type": "string" },
        "supplierId": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "integer" },
        "lowStockThreshold": { "type": "integer" },
        "warrantyMonths": { "type": "integer" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "sku", "barcode", "category", "supplierId", "purchasePrice", "salePrice", "stock", "lowStockThreshold", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "joinDate": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone"]
    },
    "Order": {
      "title": "Order",
      "description": "Sales orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "customerId": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "benefitPayRef": { "type": "string" },
        "employeeId": { "type": "string" },
        "deliveryFee": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["userId", "orderNumber", "customerId", "items", "subtotal", "discount", "total", "paymentMethod", "employeeId", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expenses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "orderId": { "type": "string" }
      },
      "required": ["userId", "category", "description", "amount"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Suppliers information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "contactPerson": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "contactPerson", "phone"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Delivery drivers",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["userId", "name"]
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Delivery tasks",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "customerId": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "deliveryDate": { "type": "string", "format": "date-time" },
        "driverId": { "type": "string" },
        "estimatedDeliveryTime": { "type": "string", "format": "date-time" },
        "currentLocation": { "type": "object" },
        "route": { "type": "object" }
      },
      "required": ["userId", "orderId", "customerId", "address", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "array" },
        "status": { "type": "string" },
        "imageUrl": { "type": "string" },
        "pin": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "permissions", "status"]
    },
    "PurchaseOrder": {
      "title": "Purchase Order",
      "description": "Inventory purchase orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "poNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "supplierId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["userId", "poNumber", "supplierId", "items", "totalAmount", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "App notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messageKey": { "type": "string" },
        "messageParams": { "type": "object" },
        "read": { "type": "boolean" },
        "date": { "type": "string", "format": "date-time" },
        "screen": { "type": "string" },
        "relatedId": { "type": "string" }
      },
      "required": ["userId", "messageKey", "read", "date", "screen"]
    },
    "Request": {
      "title": "Request",
      "description": "Website requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "status": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "items", "status"]
    },
    "RepairInvoice": {
      "title": "RepairInvoice",
      "description": "Device repair jobs and invoices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deviceType": { "type": "string" },
        "issueDescription": { "type": "string" },
        "cost": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "deviceType", "status"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Customer price offers and quotations",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerAddress": { "type": "string" },
        "taxNumber": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "vatTotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Accepted", "Rejected", "Expired", "Converted"] },
        "convertedOrderId": { "type": "string" },
        "notes": { "type": "string" },
        "terms": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "deliveryTerms": { "type": "string" },
        "preparedBy": { "type": "string" }
      },
      "required": ["quotationNumber", "customerName", "items", "total", "status"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Collection of products" },
    "customers": { "schema": "Customer", "description": "Collection of customers" },
    "orders": { "schema": "Order", "description": "Collection of sales orders" },
    "expenses": { "schema": "Expense", "description": "Collection of expenses" },
    "suppliers": { "schema": "Supplier", "description": "Collection of suppliers" },
    "drivers": { "schema": "Driver", "description": "Collection of drivers" },
    "deliveries": { "schema": "Delivery", "description": "Collection of deliveries" },
    "users": { "schema": "UserProfile", "description": "Collection of user profiles" },
    "purchase_orders": { "schema": "PurchaseOrder", "description": "Collection of purchase orders" },
    "notifications": { "schema": "Notification", "description": "Collection of notifications" },
    "requests": { "schema": "Request", "description": "Collection of website requests" },
    "repairs": { "schema": "RepairInvoice", "description": "Collection of repair records" },
    "quotations": { "schema": "Quotation", "description": "Collection of price quotations" }
  }
}
