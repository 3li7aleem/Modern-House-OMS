@echo off
chcp 65001 >nul
title Modern House OMS - بناء ملفات EXE

echo ========================================================
echo   جاري بناء تطبيق الويندوز وتوليد ملفات EXE وقاعدة البيانات المحلية
echo ========================================================
echo.

call npm.cmd run desktop:dist

if %errorlevel% neq 0 (
    echo.
    echo حدث خطأ أثناء البناء! يرجى مراجعة الرسائل أعلاه.
    pause
    exit /b %errorlevel%
)

echo.
echo ========================================================
echo   تم بناء البرنامج بنجاح! ستجد ملفات التثبيت والنسخة المحمولة في مجلد:
echo   src\desktop\release
echo ========================================================
echo.
pause
